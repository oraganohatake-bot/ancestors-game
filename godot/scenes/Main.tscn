[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/Main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/MapView.gd" id="2_mapview"]
[ext_resource type="Theme" path="res://assets/ui_theme.tres" id="3_theme"]

[sub_resource type="StyleBoxFlat" id="map_frame"]
bg_color = Color(0.02, 0.02, 0.02, 1)
border_width_top = 1
border_width_bottom = 1
border_color = Color(0.878, 0.878, 0.878, 1)

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_main")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="TopHud" type="MarginContainer" parent="Root"]
